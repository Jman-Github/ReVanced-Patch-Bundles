{
    "version": "v0.3.0",
    "patches": [
        {
            "compatiblePackages": [
                {
                    "apkFileType": "APK",
                    "appIconColor": "#1428A0",
                    "name": "Samsung Daily Board",
                    "packageName": "com.samsung.android.homemode",
                    "targets": [
                        {
                            "isExperimental": false,
                            "minSdk": 34,
                            "version": "15.1.01.3"
                        }
                    ],
                    "versions": [
                        "15.1.01.3"
                    ]
                }
            ],
            "default": false,
            "dependencies": [
                "ResourcePatch",
                "BytecodePatch"
            ],
            "description": "Runs Samsung Daily Board on phones and treats wireless charging, or charging in landscape, as docking.",
            "name": "Enable phone support",
            "options": []
        },
        {
            "compatiblePackages": [
                {
                    "apkFileType": "APKM",
                    "appIconColor": "#FC483C",
                    "name": "Instagram",
                    "packageName": "com.instagram.android",
                    "targets": [
                        {
                            "isExperimental": false,
                            "minSdk": 28,
                            "version": "426.0.0.37.68"
                        }
                    ],
                    "versions": [
                        "426.0.0.37.68"
                    ]
                }
            ],
            "default": false,
            "dependencies": [
                "BytecodePatch"
            ],
            "description": "Forces Instagram notifications into one group, or into separate groups by notification category.",
            "name": "Force notification grouping",
            "options": [
                {
                    "default": "all",
                    "description": "Choose whether every Instagram notification uses one notification group or separate groups by category.",
                    "key": "groupingMode",
                    "required": true,
                    "title": "Grouping mode",
                    "type": "kotlin.String",
                    "values": {
                        "all": "All notifications",
                        "category": "By category"
                    }
                },
                {
                    "default": false,
                    "description": "Print notification grouping decisions to logcat.",
                    "key": "debugLogging",
                    "required": false,
                    "title": "Debug logging",
                    "type": "kotlin.Boolean",
                    "values": null
                },
                {
                    "default": true,
                    "description": "When grouping all notifications together, remove sort keys and conversation hints that can make Android or One UI split Instagram notifications anyway.",
                    "key": "strictAllGrouping",
                    "required": false,
                    "title": "Strict all-notifications grouping",
                    "type": "kotlin.Boolean",
                    "values": null
                }
            ]
        }
    ]
}