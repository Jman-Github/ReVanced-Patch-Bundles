{
    "version": "v0.0.3",
    "patches": [
        {
            "name": "Disable analytics",
            "description": "Stops Pinterest's usage-event and performance uploads and AppsFlyer tracking. A switch and Pause restore those runtime paths. Firebase Analytics is disabled in the manifest and stays disabled until you patch again without this patch. Sign-in, pin requests and Firebase push components are preserved.",
            "category": "Privacy",
            "use": true,
            "dependencies": [
                "BytecodePatch",
                "HushPinterest settings",
                "ResourcePatch"
            ],
            "compatiblePackages": {
                "com.pinterest": [
                    "14.38.0",
                    "14.25.0"
